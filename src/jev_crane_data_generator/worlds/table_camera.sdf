<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Ground%20Plane</uri>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Table</uri>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Wood%20cube%205cm</uri>
      <pose>0 -0.1 1.0 0 0 0</pose>
    </include>

    <model name="route_direct_cue">
      <static>true</static>
      <pose>0.18 0.13 -1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.025</size></box>
          </geometry>
          <material>
            <ambient>0.05 0.8 0.15 1</ambient>
            <diffuse>0.05 0.8 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="route_safe_cue">
      <static>true</static>
      <pose>0.18 0.13 1.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.025</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.35 0.05 1</ambient>
            <diffuse>0.95 0.35 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dataset_camera">
      <static>true</static>
      <pose>-0.35 -0.45 1.35 0 0.38 0.76</pose>
      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <topic>/camera/image_raw</topic>
          <camera>
            <horizontal_fov>0.95</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
